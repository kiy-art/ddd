+// 2026-11-20 (営業): the "メーカー商品ページ" row is useless - and earns nothing -
+// when product_url is just the plain Rakuten item page (discovery.py stores
+// item_url there) while affiliate_url already wraps that same item and is shown
+// as the first, rewarded row; likewise an example.com dummy. Hide those two.
+export function isRedundantPlainLink(product: Pick<Product, "product_url" | "affiliate_url">): boolean {
+  const url = product.product_url;
+  if (!url) return false;
+  try {
+    const host = new URL(url).hostname;
+    if (host === "example.com" || host.endsWith(".example.com")) return true;
+    if (host.endsWith("rakuten.co.jp") && !!product.affiliate_url && product.affiliate_url.includes("rakuten.co.jp")) {
+      return true;
+    }
+  } catch {
+    // unparseable URL - keep the row as before
+  }
+  return false;
+}
