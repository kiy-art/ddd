+// 2026-11-21 (営業, v2): hide the "メーカー公式サイト" row only when it adds
+// nothing AND earns nothing:
+//  - an example.com dummy, or
+//  - a plain Rakuten item URL that is exactly the page wrapped inside this
+//    product's own Rakuten affiliate link (pc= parameter), i.e. the rewarded
+//    Rakuten row already goes to the same item.
+// A real maker URL, or a Rakuten URL that differs from the wrapped one, is kept.
+// product_url itself is not changed (data stays; only the row is hidden).
+export function isRedundantPlainLink(product: Pick<Product, "product_url" | "affiliate_url">): boolean {
+  const url = product.product_url;
+  if (!url) return false;
+  try {
+    const host = new URL(url).hostname;
+    if (host === "example.com" || host.endsWith(".example.com")) return true;
+    if (host.endsWith("rakuten.co.jp") && product.affiliate_url) {
+      const wrapped = new URL(product.affiliate_url).searchParams.get("pc");
+      return wrapped === url;
+    }
+  } catch {
+    // unparseable URL - keep the row as before
+  }
+  return false;
+}
