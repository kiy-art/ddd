+# Yahoo update-count drop warning (2026-10 SE): a quiet fall in the daily
+# Yahoo update count (e.g. rate limiting) was only visible by reading the
+# summary line. Warning level only, so it never counts as an "error".
+_YAHOO_DROP_RATIO = 0.6
+_YAHOO_DROP_MIN_HISTORY = 3
+_YAHOO_COUNT_RE = re.compile(r"Yahoo更新(\d+)件")
+
+
+def _warn_if_yahoo_dropped(db: Session, yahoo_updated: int) -> bool:
+    """Log one warning when today's Yahoo update count is under 60% of the
+    average of the last 7 days of daily_job summaries. Needs >= 3 past runs
+    with a positive average; never raises."""
+    try:
+        since = datetime.datetime.now() - datetime.timedelta(days=7)
+        rows = db.execute(
+            select(models.ErrorLog.message).where(
+                models.ErrorLog.source == "daily_job", models.ErrorLog.created_at >= since
+            )
+        ).scalars().all()
+        past = [int(m.group(1)) for m in (_YAHOO_COUNT_RE.search(r) for r in rows) if m]
+        if len(past) < _YAHOO_DROP_MIN_HISTORY:
+            return False
+        avg = sum(past) / len(past)
+        if avg <= 0 or yahoo_updated >= avg * _YAHOO_DROP_RATIO:
+            return False
+        crud.create_error_log(
+            db, source="yahoo_drop", level="warning",
+            message=f"Yahoo更新件数が低下: 今回{yahoo_updated}件 / 直近7日平均{avg:.0f}件({len(past)}回)",
+        )
+        return True
+    except Exception:  # noqa: BLE001 - monitoring must never fail the daily job
+        db.rollback()
+        return False
+
