   if (!iso) return false;
   const t = parseUtc(iso);
-  return !Number.isNaN(t) && now - t <= OFFER_FRESH_DAYS * DAY_MS;
+  return !Number.isNaN(t) && now - t <= freshWindowDays(now) * DAY_MS;
 }
 
 // Whole days since a fetch (0 = within the last 24h); null when unknown.
