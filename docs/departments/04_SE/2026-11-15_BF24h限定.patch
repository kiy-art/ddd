 export const OFFER_MAX_SHOWN_DAYS = 7;
 const DAY_MS = 24 * 60 * 60 * 1000;
 
+// 2026-11-15 (代表者会議 11/14 議題3): during the Black Friday sales only
+// (2026-11-19 00:00 JST up to, not including, 2026-12-01 00:00 JST = through
+// all of 11/30), a price counts for "the winner" / "最安" only when it was
+// fetched within the last 24 hours. Yahoo! prices are refreshed for only a
+// small part of the catalogue per day, so a 2-3 day old Yahoo! price could
+// otherwise win against a sale-day Rakuten price. After the window the
+// normal OFFER_FRESH_DAYS rule applies again - nothing to switch back.
+export const BF_FRESH_START_MS = Date.parse("2026-11-19T00:00:00+09:00");
+export const BF_FRESH_END_MS = Date.parse("2026-12-01T00:00:00+09:00");
+export const BF_OFFER_FRESH_DAYS = 1;
+
+export function isBfWindow(now: number = Date.now()): boolean {
+  return now >= BF_FRESH_START_MS && now < BF_FRESH_END_MS;
+}
+
+// How many days a price may be old and still be compared right now.
+export function freshWindowDays(now: number = Date.now()): number {
+  return isBfWindow(now) ? BF_OFFER_FRESH_DAYS : OFFER_FRESH_DAYS;
+}
+
+// For on-page wording: "24時間" during the window, else "3日".
+export function freshWindowLabel(now: number = Date.now()): string {
+  return isBfWindow(now) ? "24時間" : `${OFFER_FRESH_DAYS}日`;
+}
+
 export type ShopOffer = {
   shop: "rakuten" | "yahoo";
   label: string;
