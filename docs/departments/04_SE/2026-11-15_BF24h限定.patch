diff --git a/frontend/lib/shopOffers.test.mjs b/frontend/lib/shopOffers.test.mjs
new file mode 100644
--- /dev/null
+++ b/frontend/lib/shopOffers.test.mjs
@@ -0,0 +1,77 @@
+// Run: node --test frontend/lib/shopOffers.test.mjs   (Node 22.18+ strips the
+// types of shopOffers.ts itself; that file has only `import type`, so no
+// bundler/alias is needed). Not part of `next build` (.mjs is not in tsconfig include).
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  freshWindowDays,
+  freshWindowLabel,
+  getShopOffers,
+  isBfWindow,
+  isFresh,
+} from "./shopOffers.ts";
+
+const H = 60 * 60 * 1000;
+const at = (iso) => Date.parse(iso);
+// Backend timestamps are naive UTC ("2026-11-19T01:00:00").
+const BF_NOON = at("2026-11-19T03:00:00Z"); // 11/19 12:00 JST
+const OUT_NOON = at("2026-11-10T03:00:00Z");
+
+test("BF window: 11/19 00:00 JST (inclusive) to 12/01 00:00 JST (exclusive)", () => {
+  assert.equal(isBfWindow(at("2026-11-18T14:59:59Z")), false);
+  assert.equal(isBfWindow(at("2026-11-18T15:00:00Z")), true);
+  assert.equal(isBfWindow(at("2026-11-30T14:59:59Z")), true); // 11/30 23:59:59 JST
+  assert.equal(isBfWindow(at("2026-11-30T15:00:00Z")), false); // 12/01 00:00 JST
+});
+
+test("window days and label switch with the window", () => {
+  assert.equal(freshWindowDays(BF_NOON), 1);
+  assert.equal(freshWindowLabel(BF_NOON), "24時間");
+  assert.equal(freshWindowDays(OUT_NOON), 3);
+  assert.equal(freshWindowLabel(OUT_NOON), "3日");
+});
+
+test("isFresh: 24h inside the window, 3 days outside", () => {
+  const fetched = (now, hoursAgo) => new Date(now - hoursAgo * H).toISOString().slice(0, 19);
+  assert.equal(isFresh(fetched(BF_NOON, 23), BF_NOON), true);
+  assert.equal(isFresh(fetched(BF_NOON, 24), BF_NOON), true);
+  assert.equal(isFresh(fetched(BF_NOON, 25), BF_NOON), false);
+  assert.equal(isFresh(fetched(OUT_NOON, 25), OUT_NOON), true);
+  assert.equal(isFresh(fetched(OUT_NOON, 71), OUT_NOON), true);
+  assert.equal(isFresh(fetched(OUT_NOON, 73), OUT_NOON), false);
+  assert.equal(isFresh(null, BF_NOON), false);
+});
+
+test("getShopOffers: a 30h-old Yahoo! price is dropped only inside the window", () => {
+  const fetched = (now, hoursAgo) => new Date(now - hoursAgo * H).toISOString().slice(0, 19);
+  const product = (now) => ({
+    current_price: 50000,
+    affiliate_url: "https://item.rakuten.co.jp/shop/item/",
+    yahoo_price: 48000,
+    yahoo_url: "https://store.shopping.yahoo.co.jp/shop/item.html",
+    yahoo_updated_at: fetched(now, 30),
+  });
+  const rakutenAt = (now) => fetched(now, 2);
+
+  const inBf = getShopOffers(product(BF_NOON), rakutenAt(BF_NOON), BF_NOON);
+  assert.deepEqual(inBf.map((o) => o.shop), ["rakuten"]); // no 2-shop comparison -> no winner
+
+  const outside = getShopOffers(product(OUT_NOON), rakutenAt(OUT_NOON), OUT_NOON);
+  assert.deepEqual(outside.map((o) => o.shop), ["yahoo", "rakuten"]); // cheapest first, as today
+});
+
+test("getShopOffers: two fresh prices still compare inside the window", () => {
+  const fetched = (hoursAgo) => new Date(BF_NOON - hoursAgo * H).toISOString().slice(0, 19);
+  const offers = getShopOffers(
+    {
+      current_price: 50000,
+      affiliate_url: "https://item.rakuten.co.jp/shop/item/",
+      yahoo_price: 48000,
+      yahoo_url: "https://store.shopping.yahoo.co.jp/shop/item.html",
+      yahoo_updated_at: fetched(5),
+    },
+    fetched(2),
+    BF_NOON
+  );
+  assert.deepEqual(offers.map((o) => o.shop), ["yahoo", "rakuten"]);
+});
