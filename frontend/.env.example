NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set a GA4 Measurement ID (e.g. G-XXXXXXXXXX) to enable analytics.
# Leave unset and nothing is loaded/collected - see lib/analytics.ts.
NEXT_PUBLIC_GA_ID=
# Amazonアソシエイトのトラッキングタグ。未設定の間は lib/amazon.ts 内の
# デフォルト値（実際に登録済みの parjp-22）が使われる。環境ごとに別タグを
# 使いたい場合のみここを設定する。
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
