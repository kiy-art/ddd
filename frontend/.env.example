NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set a GA4 Measurement ID (e.g. G-XXXXXXXXXX) to enable analytics.
# Leave unset and nothing is loaded/collected - see lib/analytics.ts.
NEXT_PUBLIC_GA_ID=
# Amazonアソシエイトのトラッキングタグ（例: yourtag-22）。未設定の間は
# lib/amazon.ts内のダミータグのままリンクが生成される（クリックは動くが
# 紹介料には繋がらない）。実際のタグは、直近180日で3件以上の紹介実績を
# 作ってPA-APIの審査に通すまでの「実績作りフェーズ」用の暫定値でよい。
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
