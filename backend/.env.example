DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/golf_deals
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-5
ADMIN_API_TOKEN=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:3000
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
YAHOO_CLIENT_ID=
YAHOO_AFFILIATE_ID=
# Optional: GA4 Data API + Search Console API (see README section 6) -
# both power /admin/analytics and the STEP42 autonomous content-
# optimization daily job. A no-op until both are set.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_SITE_URL=
# Optional: Resend (https://resend.com) free-plan API key. Price-alert
# emails are a no-op until this is set - no signup required to run the app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PAR. <onboarding@resend.dev>
DAILY_REPORT_EMAIL=
# Public frontend URL, used to build links inside price-alert emails.
SITE_URL=https://golf-deals-frontend.onrender.com
# Optional: X (Twitter) API OAuth 1.0a credentials for the site's own
# posting account (App "Keys and tokens" page, app permission set to
# Read and Write). Daily "today's best deal" posting is a no-op until all
# four are set - no signup required to run the app.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
